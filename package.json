    "cz-customizable": {
      "config": ".cz-config.cjs"
    }
  },
  "dependencies": {
    "@aejkatappaja/phantom-ui": "^1.6.1",
    "@headless-tree/core": "^1.7.0",
    "@hueycolor/core": "^1.0.1",
    "@hueycolor/svelte": "^1.0.1",
    "@internationalized/date": "^3.12.3",
    "@shikijs/langs": "^4.4.2",
    "@shikijs/themes": "^4.4.2",
    "bits-ui": "^2.18.1",
    "cleave-zen": "^0.0.17",
    "clsx": "^2.1.1",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "layerchart": "^2.0.4",
    "mode-watcher": "^1.1.0",
    "runed": "0.37.1",
    "shiki": "^4.4.2",
    "svelte-tel-input": "^4.3.2",
    "svelte-toolbelt": "^0.10.6",
    "sveltekit-superforms": "^2.30.2",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.3.0",
    "zod": "^4.4.3",
    "maplibre-gl": "^5.24.0"
  },
  "devDependencies": {
    "@lucide/svelte": "^1.28.0",
    "@types/d3-shape": "^3.1.8",
    "@types/geojson": "^7946.0.16",
    "@biomejs/biome": "^2.5.7",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@sveltejs/adapter-cloudflare": "^7.2.9",
    "@sveltejs/enhanced-img": "^0.11.0",
    "@sveltejs/kit": "^2.70.2",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.1.2",
    "commit-and-tag-version": "^13.1.2",
    "cz-customizable": "^7.5.4",
    "eslint": "^10.8.0",
    "eslint-plugin-better-tailwindcss": "^4.7.0",
    "eslint-plugin-svelte": "^3.22.0",
    "husky": "^9.1.7",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte-check": "^4.7.4",
    "svelte-eslint-parser": "^1.8.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.118.0"
  },
  "license": "MIT",
  "name": "coss-ui-svelte",
  "packageManager": "pnpm@11.20.0",
  "peerDependencies": {
    "svelte": "^5.56.8"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cossui-svelte/cossui-svelte.git"
  },
  "scripts": {
    "biome:migrate": "biome migrate --write",
    "build": "vite build",
    "cf:deploy": "pnpm run build && wrangler deploy",
    "cf:typegen": "wrangler types src/worker-configuration.d.ts",
    "check": "svelte-kit sync && svelte-check --workspace .",
    "cz": "tsx ./node_modules/cz-customizable/standalone.js",
    "dev": "vite dev --open --host",
    "format": "biome check . --fix && eslint --fix && prettier --write --log-level silent '**/*.svelte'",
    "generate:registry": "tsx scripts/generateComponentRegistry.ts -w src/lib/registry/generated-registry-components.ts && tsx scripts/generateParticleRegistry.ts && pnpm format",
    "lint:audit": "pnpx knip --max-show-issues 20",
    "lint:typecheck": "tsc --noEmit",
    "mrproper": "rm -rf node_modules dist build .svelte-kit",
    "optimize:icons": "tsx ./scripts/transformLucideImports.ts",
    "prepare": "husky && svelte-kit sync || echo ''",
    "release": "commit-and-tag-version",
    "release:dry": "commit-and-tag-version --dry-run"
  },
  "type": "module",
  "version": "0.9.16"
}
