{
  "config": {
    "cz-customizable": {
      "config": ".cz-config.cjs"
    }
  },
  "dependencies": {
    "@aejkatappaja/phantom-ui": "^1.6.1",
    "@headless-tree/core": "^1.7.0",
    "@hueycolor/core": "^1.0.1",
    "@hueycolor/svelte": "^1.0.1",
    "@internationalized/date": "^3.12.3",
    "@shardsui/svelte": "0.1.0-beta.0",
    "@shikijs/langs": "^4.4.3",
    "@shikijs/themes": "^4.4.3",
    "cleave-zen": "^0.0.17",
    "clsx": "^2.1.1",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "jsrepo": "^3.8.1",
    "layerchart": "^2.3.0",
    "maplibre-gl": "^6.6.0",
    "mode-watcher": "^1.1.0",
    "runed": "0.37.1",
    "shiki": "^4.4.3",
    "svelte-tel-input": "^4.3.2",
    "svelte-toolbelt": "^0.10.6",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@jsrepo/shadcn": "^8.0.1",
    "@lucide/svelte": "^1.34.0",
    "@sveltejs/adapter-cloudflare": "^7.2.9",
    "@sveltejs/enhanced-img": "^0.11.0",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/d3-shape": "^3.2.0",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.3.0",
    "commit-and-tag-version": "^13.1.2",
    "cz-customizable": "^7.5.4",
    "eslint": "^10.9.1",
    "eslint-plugin-better-tailwindcss": "^4.7.0",
    "eslint-plugin-svelte": "^3.23.0",
    "husky": "^9.1.7",
    "svelte-check": "^4.7.6",
    "svelte-eslint-parser": "^1.8.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.125.0"
  },
  "license": "MIT",
  "name": "cossui-svelte",
  "packageManager": "pnpm@11.23.0",
  "peerDependencies": {
    "svelte": "^5.56.10"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cossui-svelte/cossui-svelte.git"
  },
  "scripts": {
    "build": "vite build",
    "cf:deploy": "pnpm run build && wrangler deploy",
    "cf:typegen": "wrangler types src/worker-configuration.d.ts",
    "check": "svelte-kit sync && svelte-check --workspace .",
    "cz": "tsx ./node_modules/cz-customizable/standalone.js",
    "dev": "vite dev --host",
    "dev:registry": "jsrepo build --watch",
    "format": "biome check . --fix --diagnostic-level=error && eslint --fix",
    "gen:registry": "tsx scripts/generateComponentRegistry.ts -w src/lib/registry/generated-registry-components.ts && tsx scripts/generateParticleRegistry.ts && rm -f static/r/*.json && jsrepo build && pnpm format",
    "lint:audit": "pnpx knip --max-show-issues 20",
    "lint:typecheck": "tsc --noEmit",
    "mrproper": "rm -rf node_modules dist build .svelte-kit",
    "migrate": "biome migrate --write && wrangler types src/worker-configuration.d.ts && tsx ./scripts/transformLucideImports.ts",
    "prepare": "pnpx -y skills@latest experimental_install 2>&1 && husky && svelte-kit sync || echo ''",
    "release": "commit-and-tag-version",
    "release:dry": "commit-and-tag-version --dry-run"
  },
  "type": "module",
  "version": "0.9.22"
}
