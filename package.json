{
  "name": "cossui-svelte",
  "version": "1.3.1",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cossui-svelte/cossui-svelte.git"
  },
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*",
    "#assets/*": "./src/lib/assets/*",
    "#data/*": "./src/lib/data/*"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build",
    "cf:deploy": "pnpm run build && wrangler deploy",
    "cf:typegen": "wrangler types src/worker-configuration.d.ts",
    "check": "rm -rf .svelte-kit/output .svelte-kit/cloudflare && svelte-kit sync && svelte-check --workspace .",
    "cz": "tsx ./node_modules/cz-customizable/standalone.js",
    "dev": "vite dev --host",
    "dev:registry": "jsrepo build --watch",
    "format": "oxlint --fix && oxfmt",
    "gen:registry": "tsx scripts/generateComponentRegistry.ts -w src/lib/registry/generated-registry-components.ts && tsx scripts/generateParticleRegistry.ts && rm -f static/r/*.json && jsrepo build && tsx scripts/postprocessRegistry.ts && pnpm format",
    "lint": "oxlint && pnpm lint:svelte",
    "lint:audit": "pnpx knip --max-show-issues 20",
    "lint:svelte": "oxvelte lint src/routes src/lib/components/app src/lib/components/ui src/lib/hooks src/lib/components/icons && oxvelte lint --config oxvelte.demos.json src/lib/components/particles src/lib/components/blocs",
    "migrate": "wrangler types src/worker-configuration.d.ts && tsx ./scripts/transformLucideImports.ts",
    "mrproper": "rm -rf node_modules dist build .svelte-kit",
    "prepare": "husky && svelte-kit sync || echo ''",
    "release": "commit-and-tag-version",
    "release:dry": "commit-and-tag-version --dry-run",
    "skills:install": "pnpx -y skills@1.7.2 experimental_install"
  },
  "dependencies": {
    "@aejkatappaja/phantom-ui": "^1.6.1",
    "@dnd-kit-svelte/svelte": "^0.2.0",
    "@dnd-kit/abstract": "^0.5.3",
    "@dnd-kit/helpers": "^0.5.3",
    "@floating-ui/dom": "^1.8.0",
    "@headless-tree/core": "^1.8.1",
    "@hueycolor/core": "^1.0.1",
    "@hueycolor/svelte": "^1.0.1",
    "@internationalized/date": "^3.12.4",
    "@shardsui/svelte": "0.1.0-beta.2",
    "@shikijs/langs": "^4.6.0",
    "@shikijs/themes": "^4.6.0",
    "@tanstack/svelte-table": "^9.3.2",
    "@tiptap/core": "^3.35.0",
    "@tiptap/extension-bubble-menu": "^3.35.0",
    "@tiptap/extension-code-block-lowlight": "^3.35.0",
    "@tiptap/extension-drag-handle": "^3.35.0",
    "@tiptap/extension-highlight": "^3.35.0",
    "@tiptap/extension-image": "^3.35.0",
    "@tiptap/extension-list": "^3.35.0",
    "@tiptap/extension-mathematics": "^3.35.0",
    "@tiptap/extension-subscript": "^3.35.0",
    "@tiptap/extension-superscript": "^3.35.0",
    "@tiptap/extension-table": "^3.35.0",
    "@tiptap/extension-table-of-contents": "^3.35.0",
    "@tiptap/extension-text-align": "^3.35.0",
    "@tiptap/extension-text-style": "^3.35.0",
    "@tiptap/extension-typography": "^3.35.0",
    "@tiptap/extensions": "^3.35.0",
    "@tiptap/markdown": "^3.35.0",
    "@tiptap/pm": "^3.35.0",
    "@tiptap/starter-kit": "^3.35.0",
    "@tiptap/suggestion": "^3.35.0",
    "chrono-node": "^2.10.3",
    "cleave-zen": "^0.0.17",
    "clsx": "^2.1.1",
    "d3-scale": "^4.0.3",
    "d3-shape": "^3.2.1",
    "dompurify": "^3.5.0",
    "jsrepo": "^3.8.5",
    "katex": "^0.19.1",
    "layerchart": "^2.13.0",
    "little-date": "^1.2.1",
    "lowlight": "^3.3.0",
    "maplibre-gl": "^6.19.0",
    "marked": "^18.3.0",
    "mermaid": "^12.3.0",
    "mode-watcher": "^1.1.0",
    "runed": "0.38.0",
    "shiki": "^4.6.0",
    "svelte-tel-input": "^4.3.4",
    "svelte-toolbelt": "^0.13.0",
    "tailwind-merge": "^3.7.1",
    "tailwind-variants": "^4.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@jsrepo/shadcn": "^8.0.5",
    "@lucide/svelte": "^1.81.0",
    "@sveltejs/adapter-cloudflare": "^9.0.1",
    "@sveltejs/enhanced-img": "^1.0.1",
    "@sveltejs/kit": "^3.4.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.2",
    "@tailwindcss/vite": "^4.3.5",
    "@types/d3-shape": "^3.2.0",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.6.11",
    "commit-and-tag-version": "^13.5.0",
    "cz-customizable": "^7.5.4",
    "husky": "^9.1.7",
    "mdsvex": "^1.1.0",
    "oxfmt": "^0.80.0",
    "oxlint": "^1.95.0",
    "oxlint-tailwindcss": "^1.17.2",
    "svelte-check": "^4.7.8",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.4.0",
    "vitest": "^5.1.2",
    "wrangler": "^4.168.0"
  },
  "peerDependencies": {
    "svelte": "^5.59.2"
  },
  "config": {
    "cz-customizable": {
      "config": ".cz-config.cjs"
    }
  },
  "packageManager": "pnpm@12.23.0"
}
