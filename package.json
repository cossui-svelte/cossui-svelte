{
  "name": "cossui-svelte",
  "version": "0.9.24",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cossui-svelte/cossui-svelte.git"
  },
  "type": "module",
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*",
    "#assets/*": "./src/lib/assets/*",
    "#data/*": "./src/lib/data/*"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build",
    "cf:deploy": "pnpm run build && wrangler deploy",
    "cf:typegen": "wrangler types src/worker-configuration.d.ts",
    "check": "svelte-kit sync && svelte-check --workspace .",
    "cz": "tsx ./node_modules/cz-customizable/standalone.js",
    "dev": "vite dev --host",
    "dev:registry": "jsrepo build --watch",
    "format": "oxlint --fix && oxfmt",
    "gen:registry": "tsx scripts/generateComponentRegistry.ts -w src/lib/registry/generated-registry-components.ts && tsx scripts/generateParticleRegistry.ts && rm -f static/r/*.json && jsrepo build && pnpm format",
    "lint": "oxlint && pnpm lint:svelte",
    "lint:audit": "pnpx knip --max-show-issues 20",
    "lint:svelte": "oxvelte lint src/routes src/lib/components/app src/lib/components/ui src/lib/hooks src/lib/icons && oxvelte lint --config oxvelte.demos.json src/lib/components/particles src/lib/components/blocs",
    "lint:typecheck": "tsc --noEmit",
    "migrate": "wrangler types src/worker-configuration.d.ts && tsx ./scripts/transformLucideImports.ts",
    "mrproper": "rm -rf node_modules dist build .svelte-kit",
    "prepare": "pnpx -y skills@latest experimental_install 2>&1 && husky && svelte-kit sync || echo ''",
    "release": "commit-and-tag-version",
    "release:dry": "commit-and-tag-version --dry-run"
  },
  "dependencies": {
    "@aejkatappaja/phantom-ui": "^1.6.1",
    "@dnd-kit-svelte/svelte": "^0.1.6",
    "@dnd-kit/abstract": "^0.5.0",
    "@dnd-kit/helpers": "^0.5.0",
    "@headless-tree/core": "^1.7.0",
    "@hueycolor/core": "^1.0.1",
    "@hueycolor/svelte": "^1.0.1",
    "@internationalized/date": "^3.12.4",
    "@shardsui/svelte": "0.1.0-beta.2",
    "@shikijs/langs": "^4.5.0",
    "@shikijs/themes": "^4.5.0",
    "@tanstack/svelte-table": "^9.2.6",
    "chrono-node": "^2.10.2",
    "cleave-zen": "^0.0.17",
    "clsx": "^2.1.1",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "jsrepo": "^3.8.1",
    "layerchart": "^2.5.1",
    "little-date": "^1.2.1",
    "maplibre-gl": "^6.12.0",
    "mode-watcher": "^1.1.0",
    "runed": "0.37.1",
    "shiki": "^4.5.0",
    "svelte-tel-input": "^4.3.3",
    "svelte-toolbelt": "^0.10.6",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@jsrepo/shadcn": "^8.0.1",
    "@lucide/svelte": "^1.52.0",
    "@sveltejs/adapter-cloudflare": "^8.0.0",
    "@sveltejs/enhanced-img": "^1.0.0",
    "@sveltejs/kit": "^3.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/d3-shape": "^3.2.0",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.6.4",
    "commit-and-tag-version": "^13.2.1",
    "cz-customizable": "^7.5.4",
    "github-slugger": "^2.0.0",
    "husky": "^9.1.7",
    "mdsvex": "^0.12.8",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.86.0",
    "oxlint-tailwindcss": "^1.14.0",
    "remark-gfm": "^4.0.1",
    "svelte-check": "^4.7.6",
    "tailwindcss": ">=4.1.17 <5",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "unist-util-visit": "^5.1.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "wrangler": "^4.147.0"
  },
  "peerDependencies": {
    "svelte": "^5.57.1"
  },
  "config": {
    "cz-customizable": {
      "config": ".cz-config.cjs"
    }
  },
  "packageManager": "pnpm@12.6.0"
}
