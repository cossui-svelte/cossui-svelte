{
    "name": "Coss.ui for Svelte",
    "short_name": "cossui-svelte",
    "description": "A port of Coss.ui components and theme to Svelte",
    "start_url": "/",
    "scope": "/",
    "icons": [
        {
            "src": "/icons/favicon.svg",
            "sizes": "any",
            "type": "image/svg+xml"
        },
        {
            "src": "/icons/icon-192.png",
            "sizes": "192x192",
            "type": "image/png"
        },
        {
            "src": "/icons/icon-512.png",
            "sizes": "512x512",
            "type": "image/png"
        }
    ],
    "theme_color": "#ffffff",
    "background_color": "#ffffff",
    "display": "standalone"
}