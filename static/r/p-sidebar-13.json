{
	"$schema": "https://ui.shadcn.com/schema/registry-item.json",
	"name": "p-sidebar-13",
	"title": "Sidebar 13",
	"description": "Sidebar open state controlled from outside the component",
	"type": "registry:block",
	"files": [
		{
			"type": "registry:block",
			"path": "p-sidebar-13.svelte",
			"target": "$lib/components/particles/sidebar/p-sidebar-13.svelte",
			"content": "<script lang=\"ts\">\n  import ChartPieIcon from '@lucide/svelte/icons/chart-pie';\n  import FrameIcon from '@lucide/svelte/icons/frame';\n  import LifeBuoyIcon from '@lucide/svelte/icons/life-buoy';\n  import MapIcon from '@lucide/svelte/icons/map';\n  import PanelLeftCloseIcon from '@lucide/svelte/icons/panel-left-close';\n  import PanelLeftOpenIcon from '@lucide/svelte/icons/panel-left-open';\n  import SendIcon from '@lucide/svelte/icons/send';\n  import { Button } from '$lib/components/ui/button';\n  import {\n    Sidebar,\n    SidebarContent,\n    SidebarGroup,\n    SidebarGroupContent,\n    SidebarGroupLabel,\n    SidebarInset,\n    SidebarMenu,\n    SidebarMenuButton,\n    SidebarMenuItem,\n    SidebarProvider\n  } from '$lib/components/ui/sidebar';\n\n  const projects = [\n    { name: 'Design Engineering', url: '#', icon: FrameIcon },\n    { name: 'Sales & Marketing', url: '#', icon: ChartPieIcon },\n    { name: 'Travel', url: '#', icon: MapIcon },\n    { name: 'Support', url: '#', icon: LifeBuoyIcon },\n    { name: 'Feedback', url: '#', icon: SendIcon }\n  ];\n\n  let open = $state(true);\n</script>\n\n<!-- transform-gpu makes this box the containing block for the sidebar's `fixed`\n     panel, so the demo stays inside the preview card instead of the viewport. -->\n<div class=\"relative h-100 w-full transform-gpu overflow-hidden rounded-xl border\">\n  <SidebarProvider bind:open class=\"h-full min-h-full\">\n    <Sidebar class=\"h-full\">\n      <SidebarContent>\n        <SidebarGroup>\n          <SidebarGroupLabel>Projects</SidebarGroupLabel>\n          <SidebarGroupContent>\n            <SidebarMenu>\n              {#each projects as project (project.name)}\n                <SidebarMenuItem>\n                  <SidebarMenuButton>\n                    {#snippet child({ props })}\n                      <a href={project.url} {...props}>\n                        <project.icon />\n                        <span>{project.name}</span>\n                      </a>\n                    {/snippet}\n                  </SidebarMenuButton>\n                </SidebarMenuItem>\n              {/each}\n            </SidebarMenu>\n          </SidebarGroupContent>\n        </SidebarGroup>\n      </SidebarContent>\n    </Sidebar>\n    <SidebarInset class=\"h-full\">\n      <header class=\"flex h-12 shrink-0 items-center gap-2 border-b px-3\">\n        <Button onclick={() => (open = !open)} size=\"sm\" variant=\"ghost\">\n          {#if open}\n            <PanelLeftCloseIcon />\n          {:else}\n            <PanelLeftOpenIcon />\n          {/if}\n          <span>{open ? 'Close' : 'Open'} Sidebar</span>\n        </Button>\n      </header>\n      <div class=\"p-4 text-muted-foreground text-sm\">\n        Sidebar is {open ? 'open' : 'closed'}\n      </div>\n    </SidebarInset>\n  </SidebarProvider>\n</div>\n"
		}
	],
	"registryDependencies": [
		"button",
		"sidebar"
	],
	"dependencies": [
		"@lucide/svelte"
	]
}