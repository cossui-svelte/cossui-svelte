{
	"$schema": "https://ui.shadcn.com/schema/registry-item.json",
	"name": "p-toast-13",
	"title": "Toast 13",
	"description": "Anchored deduplicated error toast",
	"type": "registry:block",
	"files": [
		{
			"type": "registry:block",
			"path": "p-toast-13.svelte",
			"target": "$lib/components/particles/toast/p-toast-13.svelte",
			"content": "<script lang=\"ts\">\n  import SaveIcon from '@lucide/svelte/icons/save';\n  import { buttonVariants } from '$lib/components/ui/button';\n  import { anchoredToastManager } from '$lib/components/ui/toast';\n  import {\n    Tooltip,\n    TooltipPopup,\n    TooltipProvider,\n    TooltipTrigger\n  } from '$lib/components/ui/tooltip';\n\n  const ANCHORED_SAVE_ERROR_TOAST_ID = 'coss-demo-anchored-save-error-toast';\n  const toastTimeout = 2000;\n\n  function handleSave(e: MouseEvent) {\n    const anchor = e.currentTarget as HTMLElement;\n    anchoredToastManager.add({\n      data: { tooltipStyle: true },\n      id: ANCHORED_SAVE_ERROR_TOAST_ID,\n      positionerProps: { anchor, sideOffset: 6 },\n      timeout: toastTimeout,\n      title: \"Couldn't save draft\",\n      type: 'error'\n    });\n  }\n</script>\n\n<TooltipProvider>\n  <Tooltip delay={0}>\n    <TooltipTrigger\n      aria-label=\"Save\"\n      class={buttonVariants({ size: 'icon', variant: 'outline' })}\n      onclick={handleSave}\n    >\n      <SaveIcon aria-hidden=\"true\" />\n    </TooltipTrigger>\n    <TooltipPopup>\n      <p>Save</p>\n    </TooltipPopup>\n  </Tooltip>\n</TooltipProvider>\n"
		}
	],
	"registryDependencies": [
		"button",
		"toast",
		"tooltip"
	],
	"dependencies": [
		"@lucide/svelte"
	]
}