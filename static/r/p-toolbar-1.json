{
	"$schema": "https://ui.shadcn.com/schema/registry-item.json",
	"name": "p-toolbar-1",
	"title": "Toolbar 1",
	"description": "Toolbar with toggles, buttons, and select",
	"type": "registry:block",
	"files": [
		{
			"type": "registry:block",
			"path": "p-toolbar-1.svelte",
			"target": "$lib/components/particles/toolbar/p-toolbar-1.svelte",
			"content": "<script lang=\"ts\">\n  import AlignCenterIcon from '@lucide/svelte/icons/align-center';\n  import AlignLeftIcon from '@lucide/svelte/icons/align-left';\n  import AlignRightIcon from '@lucide/svelte/icons/align-right';\n  import DollarSignIcon from '@lucide/svelte/icons/dollar-sign';\n  import PercentIcon from '@lucide/svelte/icons/percent';\n  import { Button } from '$lib/components/ui/button';\n  import { Select, SelectItem, SelectPopup, SelectTrigger } from '$lib/components/ui/select';\n  import { ToggleGroup, ToggleGroupItem } from '$lib/components/ui/toggle-group';\n  import { Toolbar, ToolbarGroup, ToolbarSeparator } from '$lib/components/ui/toolbar';\n  import {\n    Tooltip,\n    TooltipPopup,\n    TooltipProvider,\n    TooltipTrigger\n  } from '$lib/components/ui/tooltip';\n\n  const items = [\n    { label: 'Helvetica', value: 'helvetica' },\n    { label: 'Arial', value: 'arial' },\n    { label: 'Times New Roman', value: 'times-new-roman' }\n  ];\n\n  let selected = $state('helvetica');\n  const selectedLabel = $derived(items.find((i) => i.value === selected)?.label ?? '');\n</script>\n\n<TooltipProvider>\n  <Toolbar>\n    <ToggleGroup class=\"border-none p-0\" value={['left']} multiple>\n      <Tooltip>\n        <TooltipTrigger>\n          {#snippet child({ props })}\n            <ToggleGroupItem aria-label=\"Align left\" value=\"left\" {...props}>\n              <AlignLeftIcon />\n            </ToggleGroupItem>\n          {/snippet}\n        </TooltipTrigger>\n        <TooltipPopup sideOffset={8}>Align left</TooltipPopup>\n      </Tooltip>\n      <Tooltip>\n        <TooltipTrigger>\n          {#snippet child({ props })}\n            <ToggleGroupItem aria-label=\"Align center\" value=\"center\" {...props}>\n              <AlignCenterIcon />\n            </ToggleGroupItem>\n          {/snippet}\n        </TooltipTrigger>\n        <TooltipPopup sideOffset={8}>Align center</TooltipPopup>\n      </Tooltip>\n      <Tooltip>\n        <TooltipTrigger>\n          {#snippet child({ props })}\n            <ToggleGroupItem aria-label=\"Align right\" value=\"right\" {...props}>\n              <AlignRightIcon />\n            </ToggleGroupItem>\n          {/snippet}\n        </TooltipTrigger>\n        <TooltipPopup sideOffset={8}>Align right</TooltipPopup>\n      </Tooltip>\n    </ToggleGroup>\n    <ToolbarSeparator />\n    <ToolbarGroup type=\"single\">\n      <Tooltip>\n        <TooltipTrigger>\n          {#snippet child({ props })}\n            <Button aria-label=\"Format as currency\" size=\"icon\" variant=\"ghost\" {...props}>\n              <DollarSignIcon />\n            </Button>\n          {/snippet}\n        </TooltipTrigger>\n        <TooltipPopup sideOffset={8}>Format as currency</TooltipPopup>\n      </Tooltip>\n      <Tooltip>\n        <TooltipTrigger>\n          {#snippet child({ props })}\n            <Button aria-label=\"Format as percent\" size=\"icon\" variant=\"ghost\" {...props}>\n              <PercentIcon />\n            </Button>\n          {/snippet}\n        </TooltipTrigger>\n        <TooltipPopup sideOffset={8}>Format as percent</TooltipPopup>\n      </Tooltip>\n    </ToolbarGroup>\n    <ToolbarSeparator />\n    <ToolbarGroup type=\"single\">\n      <Select\n        value={selected}\n        onValueChange={(v) => {\n          selected = v;\n        }}\n      >\n        <Tooltip>\n          <TooltipTrigger>\n            {#snippet child({ props })}\n              <SelectTrigger {...props}>\n                <span class=\"flex-1 truncate\">{selectedLabel}</span>\n              </SelectTrigger>\n            {/snippet}\n          </TooltipTrigger>\n          <TooltipPopup sideOffset={8}>Select a different font</TooltipPopup>\n        </Tooltip>\n        <SelectPopup>\n          {#each items as { label, value } (value)}\n            <SelectItem {value}>{label}</SelectItem>\n          {/each}\n        </SelectPopup>\n      </Select>\n    </ToolbarGroup>\n    <ToolbarSeparator />\n    <ToolbarGroup type=\"single\">\n      <Button>Save</Button>\n    </ToolbarGroup>\n  </Toolbar>\n</TooltipProvider>\n"
		}
	],
	"registryDependencies": [
		"button",
		"select",
		"toggle-group",
		"toolbar",
		"tooltip"
	],
	"dependencies": [
		"@lucide/svelte"
	]
}