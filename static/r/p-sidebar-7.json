{
	"$schema": "https://ui.shadcn.com/schema/registry-item.json",
	"name": "p-sidebar-7",
	"title": "Sidebar 7",
	"description": "Collapsible sidebar group toggled from its label",
	"type": "registry:block",
	"files": [
		{
			"type": "registry:block",
			"path": "p-sidebar-7.svelte",
			"target": "$lib/components/particles/sidebar/p-sidebar-7.svelte",
			"content": "<script lang=\"ts\">\n  import ChevronDownIcon from '@lucide/svelte/icons/chevron-down';\n  import LifeBuoyIcon from '@lucide/svelte/icons/life-buoy';\n  import SendIcon from '@lucide/svelte/icons/send';\n  import {\n    Collapsible,\n    CollapsiblePanel,\n    CollapsibleTrigger\n  } from '$lib/components/ui/collapsible';\n  import {\n    Sidebar,\n    SidebarContent,\n    SidebarGroup,\n    SidebarGroupContent,\n    SidebarGroupLabel,\n    SidebarInset,\n    SidebarMenu,\n    SidebarMenuButton,\n    SidebarMenuItem,\n    SidebarProvider,\n    SidebarTrigger\n  } from '$lib/components/ui/sidebar';\n</script>\n\n<!-- transform-gpu makes this box the containing block for the sidebar's `fixed`\n     panel, so the demo stays inside the preview card instead of the viewport. -->\n<div class=\"relative h-100 w-full transform-gpu overflow-hidden rounded-xl border\">\n  <SidebarProvider class=\"h-full min-h-full\">\n    <Sidebar class=\"h-full\">\n      <SidebarContent>\n        <Collapsible open class=\"group/collapsible\">\n          <SidebarGroup>\n            <SidebarGroupLabel\n              class=\"text-sm hover:bg-sidebar-accent hover:text-sidebar-accent-foreground\"\n            >\n              {#snippet child({ props })}\n                <CollapsibleTrigger {...props}>\n                  Help\n                  <ChevronDownIcon\n                    class=\"ms-auto transition-transform group-data-[state=open]/collapsible:rotate-180\"\n                  />\n                </CollapsibleTrigger>\n              {/snippet}\n            </SidebarGroupLabel>\n            <CollapsiblePanel>\n              <SidebarGroupContent>\n                <SidebarMenu>\n                  <SidebarMenuItem>\n                    <SidebarMenuButton>\n                      <LifeBuoyIcon />\n                      Support\n                    </SidebarMenuButton>\n                  </SidebarMenuItem>\n                  <SidebarMenuItem>\n                    <SidebarMenuButton>\n                      <SendIcon />\n                      Feedback\n                    </SidebarMenuButton>\n                  </SidebarMenuItem>\n                </SidebarMenu>\n              </SidebarGroupContent>\n            </CollapsiblePanel>\n          </SidebarGroup>\n        </Collapsible>\n      </SidebarContent>\n    </Sidebar>\n    <SidebarInset class=\"h-full\">\n      <header class=\"flex h-12 shrink-0 items-center gap-2 border-b px-3\">\n        <SidebarTrigger />\n        <span class=\"font-medium text-sm\">Help</span>\n      </header>\n      <div class=\"p-4 text-muted-foreground text-sm\">Content area</div>\n    </SidebarInset>\n  </SidebarProvider>\n</div>\n"
		}
	],
	"registryDependencies": [
		"collapsible",
		"sidebar"
	],
	"dependencies": [
		"@lucide/svelte"
	]
}