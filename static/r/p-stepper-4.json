{
	"$schema": "https://ui.shadcn.com/schema/registry-item.json",
	"name": "p-stepper-4",
	"title": "Stepper 4",
	"description": "Stepper with tiny buttons and checkmarks",
	"type": "registry:block",
	"files": [
		{
			"type": "registry:block",
			"path": "p-stepper-4.svelte",
			"target": "$lib/components/particles/stepper/p-stepper-4.svelte",
			"content": "<script lang=\"ts\">\n  import {\n    Stepper,\n    StepperIndicator,\n    StepperItem,\n    StepperSeparator,\n    StepperTrigger\n  } from '$lib/components/ui/stepper';\n\n  const steps = [1, 2, 3, 4];\n</script>\n\n<div class=\"mx-auto max-w-xl space-y-8 text-center w-full\">\n  <Stepper step={2}>\n    {#each steps as step (step)}\n      <StepperItem class=\"not-last:flex-1\" {step}>\n        <StepperTrigger>\n          <StepperIndicator\n            class=\"size-4 data-[state=active]:border-2 data-[state=active]:border-primary data-[state=active]:bg-transparent [&_span]:sr-only [&_svg]:size-3\"\n          />\n        </StepperTrigger>\n        {#if step < steps.length}\n          <StepperSeparator />\n        {/if}\n      </StepperItem>\n    {/each}\n  </Stepper>\n</div>\n"
		}
	],
	"registryDependencies": [
		"stepper"
	],
	"dependencies": []
}