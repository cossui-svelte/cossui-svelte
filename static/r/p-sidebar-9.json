{
	"$schema": "https://ui.shadcn.com/schema/registry-item.json",
	"name": "p-sidebar-9",
	"title": "Sidebar 9",
	"description": "Sidebar menu items with a per-row action menu",
	"type": "registry:block",
	"files": [
		{
			"type": "registry:block",
			"path": "p-sidebar-9.svelte",
			"target": "$lib/components/particles/sidebar/p-sidebar-9.svelte",
			"content": "<script lang=\"ts\">\n  import ChartPieIcon from '@lucide/svelte/icons/chart-pie';\n  import EllipsisIcon from '@lucide/svelte/icons/ellipsis';\n  import FrameIcon from '@lucide/svelte/icons/frame';\n  import LifeBuoyIcon from '@lucide/svelte/icons/life-buoy';\n  import MapIcon from '@lucide/svelte/icons/map';\n  import SendIcon from '@lucide/svelte/icons/send';\n  import { Menu, MenuItem, MenuPopup, MenuTrigger } from '$lib/components/ui/menu';\n  import {\n    Sidebar,\n    SidebarContent,\n    SidebarGroup,\n    SidebarGroupContent,\n    SidebarGroupLabel,\n    SidebarInset,\n    SidebarMenu,\n    SidebarMenuAction,\n    SidebarMenuButton,\n    SidebarMenuItem,\n    SidebarProvider,\n    SidebarTrigger\n  } from '$lib/components/ui/sidebar';\n\n  const projects = [\n    { name: 'Design Engineering', url: '#', icon: FrameIcon },\n    { name: 'Sales & Marketing', url: '#', icon: ChartPieIcon },\n    { name: 'Travel', url: '#', icon: MapIcon },\n    { name: 'Support', url: '#', icon: LifeBuoyIcon },\n    { name: 'Feedback', url: '#', icon: SendIcon }\n  ];\n</script>\n\n<!-- transform-gpu makes this box the containing block for the sidebar's `fixed`\n     panel, so the demo stays inside the preview card instead of the viewport. -->\n<div class=\"relative h-100 w-full transform-gpu overflow-hidden rounded-xl border\">\n  <SidebarProvider class=\"h-full min-h-full\">\n    <Sidebar class=\"h-full\">\n      <SidebarContent>\n        <SidebarGroup>\n          <SidebarGroupLabel>Projects</SidebarGroupLabel>\n          <SidebarGroupContent>\n            <SidebarMenu>\n              {#each projects as project (project.name)}\n                <SidebarMenuItem>\n                  <SidebarMenuButton\n                    class=\"group-has-[[data-state=open]]/menu-item:bg-sidebar-accent\"\n                  >\n                    {#snippet child({ props })}\n                      <a href={project.url} {...props}>\n                        <project.icon />\n                        <span>{project.name}</span>\n                      </a>\n                    {/snippet}\n                  </SidebarMenuButton>\n                  <Menu>\n                    <MenuTrigger>\n                      {#snippet child({ props })}\n                        <SidebarMenuAction {...props}>\n                          <EllipsisIcon />\n                          <span class=\"sr-only\">More</span>\n                        </SidebarMenuAction>\n                      {/snippet}\n                    </MenuTrigger>\n                    <MenuPopup align=\"start\" side=\"right\">\n                      <MenuItem>\n                        <span>Edit Project</span>\n                      </MenuItem>\n                      <MenuItem>\n                        <span>Delete Project</span>\n                      </MenuItem>\n                    </MenuPopup>\n                  </Menu>\n                </SidebarMenuItem>\n              {/each}\n            </SidebarMenu>\n          </SidebarGroupContent>\n        </SidebarGroup>\n      </SidebarContent>\n    </Sidebar>\n    <SidebarInset class=\"h-full\">\n      <header class=\"flex h-12 shrink-0 items-center gap-2 border-b px-3\">\n        <SidebarTrigger />\n        <span class=\"font-medium text-sm\">Projects</span>\n      </header>\n      <div class=\"p-4 text-muted-foreground text-sm\">Content area</div>\n    </SidebarInset>\n  </SidebarProvider>\n</div>\n"
		}
	],
	"registryDependencies": [
		"menu",
		"sidebar"
	],
	"dependencies": [
		"@lucide/svelte"
	]
}