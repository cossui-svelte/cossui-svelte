{
	"$schema": "https://ui.shadcn.com/schema/registry-item.json",
	"name": "p-group-2",
	"title": "Group 2",
	"description": "Group with input",
	"type": "registry:block",
	"files": [
		{
			"type": "registry:block",
			"path": "p-group-2.svelte",
			"target": "$lib/components/particles/group/p-group-2.svelte",
			"content": "<script lang=\"ts\">\n  import Check from '@lucide/svelte/icons/check';\n  import Copy from '@lucide/svelte/icons/copy';\n  import { buttonVariants } from '$lib/components/ui/button';\n  import { Group, GroupSeparator } from '$lib/components/ui/group';\n  import { Input } from '$lib/components/ui/input';\n  import {\n    Tooltip,\n    TooltipPopup,\n    TooltipProvider,\n    TooltipTrigger\n  } from '$lib/components/ui/tooltip';\n\n  let inputValue = $state('https://coss.com');\n  let isCopied = $state(false);\n\n  async function copyToClipboard() {\n    await navigator.clipboard.writeText(inputValue);\n    isCopied = true;\n    setTimeout(() => {\n      isCopied = false;\n    }, 2000);\n  }\n</script>\n\n<TooltipProvider>\n  <Group aria-label=\"Url input\">\n    <Input aria-label=\"Url\" bind:value={inputValue} type=\"text\" />\n    <GroupSeparator />\n    <Tooltip>\n      <TooltipTrigger\n        aria-label=\"Copy\"\n        class={buttonVariants({ size: 'icon', variant: 'outline' })}\n        data-slot=\"button\"\n        onclick={copyToClipboard}\n      >\n        {#if isCopied}\n          <Check aria-hidden />\n        {:else}\n          <Copy aria-hidden />\n        {/if}\n      </TooltipTrigger>\n      <TooltipPopup>\n        <p>Copy to clipboard</p>\n      </TooltipPopup>\n    </Tooltip>\n  </Group>\n</TooltipProvider>\n"
		}
	],
	"registryDependencies": [
		"button",
		"group",
		"input",
		"tooltip"
	],
	"dependencies": []
}