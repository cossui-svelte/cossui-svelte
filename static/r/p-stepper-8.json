{
	"$schema": "https://ui.shadcn.com/schema/registry-item.json",
	"name": "p-stepper-8",
	"title": "Stepper 8",
	"description": "Stepper with labels",
	"type": "registry:block",
	"files": [
		{
			"type": "registry:block",
			"path": "p-stepper-8.svelte",
			"target": "$lib/components/particles/stepper/p-stepper-8.svelte",
			"content": "<script lang=\"ts\">\n  import {\n    Stepper,\n    StepperIndicator,\n    StepperItem,\n    StepperTitle,\n    StepperTrigger\n  } from '$lib/components/ui/stepper';\n\n  const steps = [\n    {\n      step: 1,\n      title: 'Step One'\n    },\n    {\n      step: 2,\n      title: 'Step Two'\n    },\n    {\n      step: 3,\n      title: 'Step Three'\n    },\n    {\n      step: 4,\n      title: 'Step Four'\n    }\n  ];\n</script>\n\n<div class=\"mx-auto max-w-xl space-y-8 text-center w-full\">\n  <Stepper class=\"gap-1\" step={2}>\n    {#each steps as { step, title } (step)}\n      <StepperItem class=\"flex-1\" {step}>\n        <StepperTrigger class=\"w-full flex-col items-start gap-2 rounded-md\">\n          <StepperIndicator\n            class=\"h-1 w-full bg-muted data-[state=active]:bg-primary data-[state=completed]:bg-primary\"\n          >\n            <span class=\"sr-only\">{step}</span>\n          </StepperIndicator>\n          <div class=\"space-y-0.5\">\n            <StepperTitle>{title}</StepperTitle>\n          </div>\n        </StepperTrigger>\n      </StepperItem>\n    {/each}\n  </Stepper>\n</div>\n"
		}
	],
	"registryDependencies": [
		"stepper"
	],
	"dependencies": []
}