{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "p-avatar-19",
  "title": "Avatar 19",
  "description": "Avatars sized from a parent element",
  "type": "registry:block",
  "files": [
    {
      "type": "registry:block",
      "path": "p-avatar-19.svelte",
      "target": "particles/avatar/p-avatar-19.svelte",
      "content": "<script lang=\"ts\">\n  import { Avatar, AvatarFallback, AvatarImage } from '$lib/components/ui/avatar/index.js';\n\n  const people = [\n    {\n      initials: 'FK',\n      name: 'Frida Kahlo',\n      photo: 'photo-1543610892-0b1f7e6d8ac1',\n      role: 'Design'\n    },\n    {\n      initials: 'NE',\n      name: 'Nadia Ekman',\n      photo: 'photo-1628157588553-5eeea00af15c',\n      role: 'Engineering'\n    },\n    { initials: 'EW', name: 'Eli Wren', photo: '', role: 'Research' }\n  ];\n</script>\n\n<div class=\"flex w-full flex-col gap-4 [--avatar-size:--spacing(10)]\">\n  {#each people as person (person.initials)}\n    <div class=\"flex items-center gap-3\">\n      <Avatar>\n        {#if person.photo}\n          <AvatarImage\n            alt={person.name}\n            src=\"https://images.unsplash.com/{person.photo}?w=120&h=120&dpr=2&q=80\"\n          />\n        {/if}\n        <AvatarFallback>{person.initials}</AvatarFallback>\n      </Avatar>\n      <div class=\"flex min-w-0 flex-col\">\n        <span class=\"truncate text-sm font-medium\">{person.name}</span>\n        <span class=\"truncate text-xs text-muted-foreground\">{person.role}</span>\n      </div>\n    </div>\n  {/each}\n</div>\n"
    }
  ],
  "registryDependencies": [
    "https://cossui-svelte.com/r/avatar.json"
  ],
  "dependencies": []
}
