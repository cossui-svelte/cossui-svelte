{
	"$schema": "https://ui.shadcn.com/schema/registry-item.json",
	"name": "p-field-18",
	"title": "Field 18",
	"description": "Complete form built with field",
	"type": "registry:block",
	"files": [
		{
			"type": "registry:block",
			"path": "p-field-18.svelte",
			"target": "$lib/components/particles/field/p-field-18.svelte",
			"content": "<script lang=\"ts\">\n  import { Button } from '$lib/components/ui/button';\n  import { Checkbox } from '$lib/components/ui/checkbox';\n  import { Field, FieldDescription, FieldError, FieldLabel } from '$lib/components/ui/field';\n  import { Form } from '$lib/components/ui/form';\n  import { Input } from '$lib/components/ui/input';\n  import {\n    Select,\n    SelectContent,\n    SelectItem,\n    SelectTrigger,\n    SelectValue\n  } from '$lib/components/ui/select';\n\n  let loading = $state(false);\n\n  async function handleSubmit(event: SubmitEvent) {\n    event.preventDefault();\n    const formData = new FormData(event.currentTarget as HTMLFormElement);\n    loading = true;\n    await new Promise((r) => setTimeout(r, 800));\n    loading = false;\n    alert(\n      `Full name: ${formData.get('fullName')}\\nEmail: ${formData.get('email')}\\nRole: ${\n        formData.get('role') ?? ''\n      }\\nNewsletter: ${formData.get('newsletter') === 'on'}`\n    );\n  }\n</script>\n\n<Form class=\"flex w-full flex-col gap-4\" onsubmit={handleSubmit}>\n  <Field name=\"fullName\">\n    <FieldLabel>Full Name <span class=\"text-destructive\">*</span></FieldLabel>\n    <Input placeholder=\"John Doe\" required type=\"text\" />\n    <FieldError>Please enter a valid name.</FieldError>\n  </Field>\n\n  <Field name=\"email\">\n    <FieldLabel>Email <span class=\"text-destructive\">*</span></FieldLabel>\n    <Input placeholder=\"john@example.com\" required type=\"email\" />\n    <FieldError>Please enter a valid email.</FieldError>\n  </Field>\n\n  <Field name=\"role\">\n    <FieldLabel>Role</FieldLabel>\n    <Select>\n      <SelectTrigger>\n        <SelectValue placeholder=\"Select your role\" />\n      </SelectTrigger>\n      <SelectContent>\n        <SelectItem value=\"developer\">Developer</SelectItem>\n        <SelectItem value=\"designer\">Designer</SelectItem>\n        <SelectItem value=\"manager\">Product Manager</SelectItem>\n        <SelectItem value=\"other\">Other</SelectItem>\n      </SelectContent>\n    </Select>\n    <FieldDescription>This is an optional field</FieldDescription>\n  </Field>\n\n  <Field name=\"newsletter\">\n    <div class=\"flex items-center gap-2\">\n      <Checkbox />\n      <FieldLabel class=\"cursor-pointer\">Subscribe to newsletter</FieldLabel>\n    </div>\n  </Field>\n\n  <Button {loading} type=\"submit\">Submit</Button>\n</Form>\n"
		}
	],
	"registryDependencies": [
		"button",
		"checkbox",
		"field",
		"form",
		"input",
		"select"
	],
	"dependencies": []
}