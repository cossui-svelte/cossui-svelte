{
	"$schema": "https://ui.shadcn.com/schema/registry-item.json",
	"name": "p-card-7",
	"title": "Card 7",
	"description": "Framed card with no rounded bottom",
	"type": "registry:block",
	"files": [
		{
			"type": "registry:block",
			"path": "p-card-7.svelte",
			"target": "$lib/components/particles/card/p-card-7.svelte",
			"content": "<script lang=\"ts\">\n  import CircleAlert from '@lucide/svelte/icons/circle-alert';\n  import { Button } from '$lib/components/ui/button';\n  import {\n    Card,\n    CardFrame,\n    CardFrameDescription,\n    CardFrameFooter,\n    CardFrameHeader,\n    CardFrameTitle,\n    CardPanel\n  } from '$lib/components/ui/card';\n  import { Field, FieldLabel } from '$lib/components/ui/field';\n  import { Form } from '$lib/components/ui/form';\n  import { Input } from '$lib/components/ui/input';\n  import {\n    Select,\n    SelectItem,\n    SelectPopup,\n    SelectTrigger,\n    SelectValue\n  } from '$lib/components/ui/select';\n\n  const frameworkOptions = [\n    { label: 'Next.js', value: 'next' },\n    { label: 'Vite', value: 'vite' },\n    { label: 'Remix', value: 'remix' },\n    { label: 'Astro', value: 'astro' }\n  ] as const;\n</script>\n\n<CardFrame class=\"w-full max-w-xs\">\n  <CardFrameHeader>\n    <CardFrameTitle>Create project</CardFrameTitle>\n    <CardFrameDescription>Deploy your new project in one-click.</CardFrameDescription>\n  </CardFrameHeader>\n  <Card class=\"rounded-b-none!\">\n    <CardPanel>\n      <Form class=\"flex w-full flex-col gap-4\">\n        <Field>\n          <FieldLabel>Name</FieldLabel>\n          <Input placeholder=\"Name of your project\" type=\"text\" />\n        </Field>\n        <Field>\n          <FieldLabel>Framework</FieldLabel>\n          <Select value=\"next\">\n            <SelectTrigger>\n              <SelectValue />\n            </SelectTrigger>\n            <SelectPopup>\n              {#each frameworkOptions as { label, value } (value)}\n                <SelectItem {value} {label} />\n              {/each}\n            </SelectPopup>\n          </Select>\n        </Field>\n        <Button class=\"w-full\" type=\"submit\">Deploy</Button>\n      </Form>\n    </CardPanel>\n  </Card>\n  <CardFrameFooter>\n    <div class=\"flex gap-1 text-muted-foreground text-xs\">\n      <CircleAlert class=\"size-3 h-lh shrink-0\" />\n      <p>This will take a few seconds to complete.</p>\n    </div>\n  </CardFrameFooter>\n</CardFrame>\n"
		}
	],
	"registryDependencies": [
		"button",
		"card",
		"field",
		"form",
		"input",
		"select"
	],
	"dependencies": [
		"@lucide/svelte"
	]
}