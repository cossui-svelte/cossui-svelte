{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "p-composer-4",
  "title": "Composer 4",
  "description": "Composer surface with a native textarea",
  "type": "registry:block",
  "files": [
    {
      "type": "registry:block",
      "path": "p-composer-4.svelte",
      "target": "particles/composer/p-composer-4.svelte",
      "content": "<script lang=\"ts\">\n  import ArrowUp from '@lucide/svelte/icons/arrow-up';\n  import Paperclip from '@lucide/svelte/icons/paperclip';\n  import { Button } from '$lib/components/ui/button/index.js';\n  import {\n    Composer,\n    ComposerActionGroup,\n    ComposerActions,\n    ComposerInput,\n    ComposerSubmit,\n    getComposerText,\n    type ComposerValue\n  } from '$lib/components/ui/composer/index.js';\n\n  let value = $state<ComposerValue>([]);\n  let notice = $state('');\n</script>\n\n<div class=\"flex w-full max-w-xl flex-col gap-3\">\n  <Composer\n    bind:value\n    onSubmit={(draft) => {\n      notice = `Sent: ${getComposerText(draft)}`;\n      value = [];\n    }}\n  >\n    <ComposerInput as=\"textarea\" aria-label=\"Plain message\" placeholder=\"Write a message…\" />\n    <ComposerActions>\n      <ComposerActionGroup>\n        <Button\n          aria-label=\"Attach a file\"\n          size=\"icon\"\n          type=\"button\"\n          variant=\"ghost\"\n          onclick={() => (notice = 'Attach a file')}\n        >\n          <Paperclip aria-hidden=\"true\" />\n        </Button>\n      </ComposerActionGroup>\n      <ComposerActionGroup align=\"end\">\n        <ComposerSubmit aria-label=\"Send message\" size=\"icon\">\n          <ArrowUp aria-hidden=\"true\" />\n        </ComposerSubmit>\n      </ComposerActionGroup>\n    </ComposerActions>\n  </Composer>\n  <p class=\"min-h-5 text-muted-foreground text-sm\" role=\"status\">{notice}</p>\n</div>\n"
    }
  ],
  "registryDependencies": [
    "https://cossui-svelte.com/r/button.json",
    "https://cossui-svelte.com/r/composer.json"
  ],
  "dependencies": [
    "@lucide/svelte"
  ]
}
