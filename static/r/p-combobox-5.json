{
	"$schema": "https://ui.shadcn.com/schema/registry-item.json",
	"name": "p-combobox-5",
	"title": "Combobox 5",
	"description": "Combobox with label",
	"type": "registry:block",
	"files": [
		{
			"type": "registry:block",
			"path": "p-combobox-5.svelte",
			"target": "$lib/components/particles/combobox/p-combobox-5.svelte",
			"content": "<script lang=\"ts\">\n  import {\n    Combobox,\n    ComboboxCollection,\n    ComboboxEmpty,\n    ComboboxInput,\n    ComboboxItem,\n    ComboboxList,\n    ComboboxPopup\n  } from '$lib/components/ui/combobox';\n  import { Label } from '$lib/components/ui/label';\n\n  const id = $props.id();\n\n  const items = [\n    { label: 'Apple', value: 'apple' },\n    { label: 'Banana', value: 'banana' },\n    { label: 'Orange', value: 'orange' },\n    { label: 'Grape', value: 'grape' },\n    { label: 'Strawberry', value: 'strawberry' },\n    { label: 'Mango', value: 'mango' },\n    { label: 'Pineapple', value: 'pineapple' },\n    { label: 'Kiwi', value: 'kiwi' },\n    { label: 'Peach', value: 'peach' },\n    { label: 'Pear', value: 'pear' }\n  ];\n</script>\n\n<Combobox {items}>\n  <div class=\"flex flex-col items-start gap-2\">\n    <Label for={id}>Fruits</Label>\n    <ComboboxInput aria-label=\"Select an item\" {id} placeholder=\"Select an item...\" />\n  </div>\n  <ComboboxPopup>\n    <ComboboxEmpty>No results found.</ComboboxEmpty>\n    <ComboboxList>\n      <ComboboxCollection>\n        {#snippet children(item: { label: string; value: string })}\n          <ComboboxItem value={item.value} label={item.label}>{item.label}</ComboboxItem>\n        {/snippet}\n      </ComboboxCollection>\n    </ComboboxList>\n  </ComboboxPopup>\n</Combobox>\n"
		}
	],
	"registryDependencies": [
		"combobox",
		"label"
	],
	"dependencies": []
}