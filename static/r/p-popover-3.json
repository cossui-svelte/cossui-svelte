{
	"$schema": "https://ui.shadcn.com/schema/registry-item.json",
	"name": "p-popover-3",
	"title": "Popover 3",
	"description": "Animated popovers",
	"type": "registry:block",
	"files": [
		{
			"type": "registry:block",
			"path": "p-popover-3.svelte",
			"target": "$lib/components/particles/popover/p-popover-3.svelte",
			"content": "<script lang=\"ts\">\n  import Bell from '@lucide/svelte/icons/bell';\n  import User from '@lucide/svelte/icons/user';\n  import { Avatar, AvatarFallback, AvatarImage } from '$lib/components/ui/avatar';\n  import { Button, buttonVariants } from '$lib/components/ui/button';\n  import {\n    Popover,\n    PopoverDescription,\n    PopoverPopup,\n    PopoverTitle,\n    PopoverTrigger\n  } from '$lib/components/ui/popover';\n\n  type ActivePanel = 'notifications' | 'profile' | null;\n\n  let open = $state(false);\n  let activePanel = $state<ActivePanel>(null);\n\n  function openWith(panel: ActivePanel) {\n    activePanel = panel;\n    open = true;\n  }\n</script>\n\n<div class=\"flex gap-2\">\n  <button\n    aria-label=\"Notifications\"\n    class={buttonVariants({ size: 'icon', variant: 'outline' })}\n    onclick={() => openWith('notifications')}\n    type=\"button\"\n  >\n    <Bell aria-hidden=\"true\" />\n  </button>\n  <button\n    aria-label=\"Profile\"\n    class={buttonVariants({ size: 'icon', variant: 'outline' })}\n    onclick={() => openWith('profile')}\n    type=\"button\"\n  >\n    <User aria-hidden=\"true\" />\n  </button>\n  <Popover bind:open>\n    <PopoverTrigger class=\"hidden\" aria-hidden tabindex={-1} />\n    <PopoverPopup class=\"min-w-none\">\n      {#if activePanel === 'notifications'}\n        <PopoverTitle class=\"text-base\">Notifications</PopoverTitle>\n        <PopoverDescription>You have no new notifications at this time.</PopoverDescription>\n      {:else if activePanel === 'profile'}\n        <div class=\"w-48\">\n          <div class=\"flex items-center gap-3\">\n            <Avatar>\n              <AvatarImage\n                alt=\"Mark Andersson\"\n                src=\"https://images.unsplash.com/photo-1543610892-0b1f7e6d8ac1?w=128&h=128&dpr=2&q=80\"\n              />\n              <AvatarFallback>MA</AvatarFallback>\n            </Avatar>\n            <div class=\"min-w-0 flex-1\">\n              <h4 class=\"line-clamp-1 font-medium text-sm\">Mark Andersson</h4>\n              <div class=\"flex items-center gap-3 text-muted-foreground text-xs\">\n                Product Designer\n              </div>\n            </div>\n          </div>\n          <Button class=\"mt-3 w-full\" size=\"sm\" variant=\"outline\">Log out</Button>\n        </div>\n      {/if}\n    </PopoverPopup>\n  </Popover>\n</div>\n"
		}
	],
	"registryDependencies": [
		"avatar",
		"button",
		"popover"
	],
	"dependencies": [
		"@lucide/svelte"
	]
}