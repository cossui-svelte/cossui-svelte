{
	"$schema": "https://ui.shadcn.com/schema/registry-item.json",
	"name": "p-stepper-15",
	"title": "Stepper 15",
	"description": "Vertical stepper with numbers and checkmarks",
	"type": "registry:block",
	"files": [
		{
			"type": "registry:block",
			"path": "p-stepper-15.svelte",
			"target": "$lib/components/particles/stepper/p-stepper-15.svelte",
			"content": "<script lang=\"ts\">\n  import {\n    Stepper,\n    StepperIndicator,\n    StepperItem,\n    StepperSeparator,\n    StepperTrigger\n  } from '$lib/components/ui/stepper';\n\n  const steps = [1, 2, 3, 4];\n</script>\n\n<div class=\"space-y-8 text-center\">\n  <Stepper orientation=\"vertical\" step={2}>\n    {#each steps as step (step)}\n      <StepperItem class=\"not-last:flex-1\" {step}>\n        <StepperTrigger>\n          <StepperIndicator />\n        </StepperTrigger>\n        {#if step < steps.length}\n          <StepperSeparator />\n        {/if}\n      </StepperItem>\n    {/each}\n  </Stepper>\n</div>\n"
		}
	],
	"registryDependencies": [
		"stepper"
	],
	"dependencies": []
}