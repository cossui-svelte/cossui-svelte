{
	"$schema": "https://ui.shadcn.com/schema/registry-item.json",
	"name": "colorpicker",
	"title": "Colorpicker",
	"description": "A specialized dropdown for selecting colors.",
	"type": "registry:ui",
	"files": [
		{
			"type": "registry:ui",
			"path": "colorpicker/color-picker-swatches.svelte",
			"target": "$lib/components/ui/colorpicker/color-picker-swatches.svelte",
			"content": "<script lang=\"ts\">\n  import PlusIcon from '@lucide/svelte/icons/plus';\n  import XIcon from '@lucide/svelte/icons/x';\n  import { hueyColor } from '@hueycolor/core';\n  import { useHueyContext } from '@hueycolor/svelte';\n\n  let { swatches = $bindable(), editable = true }: { swatches: string[]; editable?: boolean } =\n    $props();\n\n  const ctx = useHueyContext();\n\n  function selectSwatch(swatchColor: string) {\n    ctx.setColor(swatchColor);\n  }\n\n  function addSwatch() {\n    const hex = ctx.colorValue.toHexString();\n    if (!swatches.some((s) => hueyColor(s).toHexString() === hex)) {\n      swatches = [...swatches, hex];\n    }\n  }\n\n  function removeSwatch(target: string) {\n    swatches = swatches.filter((s) => s !== target);\n  }\n</script>\n\n<div class=\"flex flex-wrap items-center gap-2\" role=\"listbox\" aria-label=\"Color swatches\">\n  {#each swatches as swatchColor (swatchColor)}\n    <div class=\"group relative flex\">\n      <button\n        type=\"button\"\n        role=\"option\"\n        aria-label={swatchColor}\n        aria-selected={ctx.colorValue.toHexString() === hueyColor(swatchColor).toHexString()}\n        class=\"size-5 shrink-0 cursor-pointer rounded ring-1 ring-inset ring-border transition-shadow focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring\"\n        style:background={swatchColor}\n        onclick={() => selectSwatch(swatchColor)}\n      ></button>\n      {#if editable}\n        <button\n          type=\"button\"\n          aria-label={`Remove ${swatchColor}`}\n          class=\"absolute -top-1.5 -right-1.5 hidden size-3.5 items-center justify-center rounded-full border border-border bg-popover text-muted-foreground opacity-0 shadow-xs transition-opacity group-hover:flex group-hover:opacity-100 group-focus-within:flex group-focus-within:opacity-100 hover:border-destructive hover:bg-destructive hover:text-white focus-visible:flex focus-visible:opacity-100 focus-visible:outline-none\"\n          onclick={(e) => {\n            e.stopPropagation();\n            removeSwatch(swatchColor);\n          }}\n        >\n          <XIcon class=\"size-2.5\" />\n        </button>\n      {/if}\n    </div>\n  {/each}\n  {#if editable}\n    <button\n      type=\"button\"\n      aria-label=\"Add current color to swatches\"\n      class=\"flex size-5 shrink-0 cursor-pointer items-center justify-center rounded border border-dashed border-input text-muted-foreground transition-colors hover:border-ring hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring\"\n      onclick={addSwatch}\n    >\n      <PlusIcon class=\"size-3\" />\n    </button>\n  {/if}\n</div>\n"
		},
		{
			"type": "registry:ui",
			"path": "colorpicker/color-picker.svelte",
			"target": "$lib/components/ui/colorpicker/color-picker.svelte",
			"content": "<script lang=\"ts\">\n  import PipetteIcon from '@lucide/svelte/icons/pipette';\n  import { type HueyColor } from '@hueycolor/core';\n  import {\n    AlphaInput,\n    AlphaSlider,\n    BlueInput,\n    ColorDropper,\n    GreenInput,\n    HexInput,\n    HueInput,\n    HueSlider,\n    HueyRoot,\n    LightnessInput,\n    RedInput,\n    SaturationArea,\n    SaturationInput\n  } from '@hueycolor/svelte';\n  import { Popover, PopoverPopup, PopoverTrigger } from '$lib/components/ui/popover';\n  import ColorPickerSwatches from './color-picker-swatches.svelte';\n\n  let {\n    color = $bindable(),\n    swatches = $bindable(),\n    showSaturationArea = true,\n    showInputs = true,\n    showColorDropper = true,\n    showColorSliders = true,\n    swatchesEditable = true\n  }: {\n    color: string | HueyColor;\n    swatches?: string[];\n    showSaturationArea?: boolean;\n    showInputs?: boolean;\n    showColorDropper?: boolean;\n    showColorSliders?: boolean;\n    swatchesEditable?: boolean;\n  } = $props();\n\n  // let color = $state(hueyColor(\"#acff00\"));\n  let colorFormat = $state<'hex' | 'hsl' | 'rgb'>('hex');\n\n  const inputBase = 'text-center h-6 text-xs px-1 min-w-0 w-full border-0 bg-muted text-foreground';\n  const inputFirst = `${inputBase} rounded-l`;\n  const inputMiddle = `${inputBase} border-l-2 border-l-popover`;\n  const inputAlpha = `${inputBase} border-l-2 border-l-popover rounded-r w-12 shrink-0`;\n</script>\n\n{#snippet marker(selectedColor)}\n  <span\n    class=\"inline-block size-4 shrink-0 rounded-full ring-2 ring-offset-2 ring-offset-background transition duration-200 hover:ring-[--marker-ring-color]\"\n    style:background={selectedColor.toString()}\n    style:--marker-ring-color={selectedColor.toString()}\n  ></span>\n{/snippet}\n\n{#snippet child()}\n  {#if showSaturationArea}\n    <div class=\"p-4\">\n      <SaturationArea\n        colorFormat=\"hex\"\n        class=\"w-full! h-36! rounded-lg! shadow-[0_0_1px_1px_var(--border)]\"\n      />\n    </div>\n  {/if}\n  {#if showColorDropper || showColorSliders}\n    <div class={[showInputs || swatches ? 'px-4' : 'px-4 py-4', 'flex gap-2']}>\n      {#if showColorDropper}\n        <ColorDropper\n          class=\"text-muted-foreground hover:text-foreground bg-transparent border-0 p-0 transition-colors\"\n        >\n          <PipetteIcon />\n        </ColorDropper>\n      {/if}\n      {#if showColorSliders}\n        <div class=\"flex flex-col gap-2 px-2 flex-1\">\n          <HueSlider class=\"[--huey-slider-track-width:100%]! [--huey-slider-track-height:24px]!\" />\n          <AlphaSlider\n            class=\"[--huey-slider-track-width:100%]! [--huey-slider-track-height:24px]!\"\n          />\n        </div>\n      {/if}\n    </div>\n  {/if}\n  {#if showInputs}\n    <div class=\"flex gap-2 p-4\">\n      <label for=\"color-format\" class=\"flex\">\n        <span class=\"sr-only\">Color Format</span>\n        <select\n          id=\"color-format\"\n          bind:value={colorFormat}\n          name=\"color-format\"\n          class=\"bg-transparent border border-input rounded text-foreground text-xs h-6 pl-1\"\n        >\n          <option value=\"hex\">Hex</option>\n          <option value=\"rgb\">RGB</option>\n          <option value=\"hsl\">HSL</option>\n        </select>\n      </label>\n      <div class=\"flex-1 flex\">\n        {#if colorFormat === 'hex'}\n          <label for=\"hex-input\" class=\"flex\">\n            <span class=\"sr-only\">Hex</span>\n            <HexInput id=\"hex-input\" alpha={false} class={inputFirst} />\n          </label>\n        {/if}\n        {#if colorFormat === 'hsl'}\n          <label for=\"hue\" class=\"flex\">\n            <span class=\"sr-only\">Hue</span>\n            <HueInput id=\"hue\" class={inputFirst} />\n          </label>\n          <label for=\"saturation\" class=\"flex\">\n            <span class=\"sr-only\">Saturation</span>\n            <SaturationInput id=\"saturation\" class={inputMiddle} />\n          </label>\n          <label for=\"lightness\" class=\"flex\">\n            <span class=\"sr-only\">Lightness</span>\n            <LightnessInput id=\"lightness\" class={inputMiddle} />\n          </label>\n        {/if}\n        {#if colorFormat === 'rgb'}\n          <label for=\"red\" class=\"flex\">\n            <span class=\"sr-only\">Red</span>\n            <RedInput id=\"red\" class={inputFirst} />\n          </label>\n          <label for=\"green\" class=\"flex\">\n            <span class=\"sr-only\">Green</span>\n            <GreenInput id=\"green\" class={inputMiddle} />\n          </label>\n          <label for=\"blue\" class=\"flex\">\n            <span class=\"sr-only\">Blue</span>\n            <BlueInput id=\"blue\" class={inputMiddle} />\n          </label>\n        {/if}\n        <label for=\"alpha\" class=\"flex\">\n          <span class=\"sr-only\">Alpha</span>\n          <AlphaInput id=\"alpha\" class={inputAlpha} />\n        </label>\n      </div>\n    </div>\n  {/if}\n  {#if swatches}\n    <div class=\"border-t border-border p-4\">\n      <ColorPickerSwatches bind:swatches editable={swatchesEditable} />\n    </div>\n  {/if}\n{/snippet}\n\n<Popover>\n  <PopoverTrigger>\n    {@render marker(color)}\n  </PopoverTrigger>\n  <PopoverPopup class=\"w-70 p-0\">\n    <HueyRoot bind:color>\n      {@render child()}\n    </HueyRoot>\n  </PopoverPopup>\n</Popover>\n"
		},
		{
			"type": "registry:ui",
			"path": "colorpicker/index.ts",
			"target": "$lib/components/ui/colorpicker/index.ts",
			"content": "export { default as ColorPicker } from './color-picker.svelte';\n\nimport { type HueyColor } from '@hueycolor/core';\n\nexport type { HueyColor };\n"
		}
	],
	"registryDependencies": [
		"popover"
	],
	"dependencies": [
		"@hueycolor/core@^1.0.1",
		"@hueycolor/svelte@^1.0.1"
	]
}