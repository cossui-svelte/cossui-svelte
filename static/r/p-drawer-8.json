alue=\"bora@example.com\" />\n              </Field>\n            </DrawerPanel>\n            <DrawerFooter>\n              <DrawerClose class={buttonVariants({ variant: 'ghost' })}>Cancel</DrawerClose>\n              <Button type=\"submit\">Save changes</Button>\n            </DrawerFooter>\n          </Form>\n        </DrawerPopup>\n      </Drawer>\n    </DrawerFooter>\n  </DrawerPopup>\n</Drawer>\n"
