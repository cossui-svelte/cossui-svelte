{
	"$schema": "https://ui.shadcn.com/schema/registry-item.json",
	"name": "p-slider-14",
	"title": "Slider 14",
	"description": "Slider with increment and decrement buttons",
	"type": "registry:block",
	"files": [
		{
			"type": "registry:block",
			"path": "p-slider-14.svelte",
			"target": "$lib/components/particles/slider/p-slider-14.svelte",
			"content": "<script lang=\"ts\">\n  import MinusIcon from '@lucide/svelte/icons/minus';\n  import PlusIcon from '@lucide/svelte/icons/plus';\n  import { Button } from '$lib/components/ui/button';\n  import { Slider } from '$lib/components/ui/slider';\n\n  const min = 0;\n  const max = 200;\n  const step = 5;\n\n  let value = $state(100);\n</script>\n\n<div class=\"flex flex-col gap-1.5\">\n  <span class=\"tabular-nums text-sm font-medium\">{value} credits/mo</span>\n  <div class=\"flex items-center gap-2\">\n    <Button\n      aria-label=\"Decrease value\"\n      disabled={value === min}\n      onclick={() => {\n        value = Math.max(min, value - step);\n      }}\n      size=\"icon\"\n      variant=\"outline\"\n    >\n      <MinusIcon aria-hidden=\"true\" />\n    </Button>\n    <Slider aria-label=\"Credits slider\" class=\"flex-1\" {max} {min} {step} bind:value />\n    <Button\n      aria-label=\"Increase value\"\n      disabled={value === max}\n      onclick={() => {\n        value = Math.min(max, value + step);\n      }}\n      size=\"icon\"\n      variant=\"outline\"\n    >\n      <PlusIcon aria-hidden=\"true\" />\n    </Button>\n  </div>\n</div>\n"
		}
	],
	"registryDependencies": [
		"button",
		"field",
		"slider"
	],
	"dependencies": [
		"@lucide/svelte"
	]
}