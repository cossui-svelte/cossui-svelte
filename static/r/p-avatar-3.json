  "name": "p-avatar-3",
  "title": "Avatar 3",
  "description": "Avatars with different sizes",
  "type": "registry:block",
  "files": [
    {
      "type": "registry:block",
      "path": "p-avatar-3.svelte",
      "target": "particles/avatar/p-avatar-3.svelte",
      "content": "<script lang=\"ts\">\n  import { Avatar, AvatarFallback, AvatarImage } from '$lib/components/ui/avatar/index.js';\n\n  const sizes = [\n    { px: 48, size: '[--avatar-size:--spacing(4)]' },\n    { px: 72, size: '[--avatar-size:--spacing(6)]' },\n    { px: 96, size: '[--avatar-size:--spacing(8)]' },\n    { px: 120, size: '[--avatar-size:--spacing(10)]' },\n    { px: 144, size: '[--avatar-size:--spacing(12)]' }\n  ];\n</script>\n\n<div class=\"flex flex-col gap-4\">\n  <div class=\"flex items-center gap-4\">\n    {#each sizes as { px, size } (px)}\n      <Avatar class={size}>\n        <AvatarImage\n          alt=\"User\"\n          src=\"https://images.unsplash.com/photo-1543610892-0b1f7e6d8ac1?w={px}&h={px}&dpr=2&q=80\"\n        />\n        <AvatarFallback>AV</AvatarFallback>\n      </Avatar>\n    {/each}\n  </div>\n  <div class=\"flex items-center gap-4\">\n    {#each sizes as { px, size } (px)}\n      <Avatar class={size}>\n        <AvatarFallback>AV</AvatarFallback>\n      </Avatar>\n    {/each}\n  </div>\n</div>\n"
    }
  ],
  "registryDependencies": [
    "https://cossui-svelte.com/r/avatar.json"
