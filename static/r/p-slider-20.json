{
	"$schema": "https://ui.shadcn.com/schema/registry-item.json",
	"name": "p-slider-20",
	"title": "Slider 20",
	"description": "Equalizer with vertical sliders",
	"type": "registry:block",
	"files": [
		{
			"type": "registry:block",
			"path": "p-slider-20.svelte",
			"target": "$lib/components/particles/slider/p-slider-20.svelte",
			"content": "<script lang=\"ts\">\n  import { Slider } from '$lib/components/ui/slider';\n\n  const bands = [\n    { label: '60 Hz', value: 2 },\n    { label: '250 Hz', value: 1 },\n    { label: '1k', value: -1 },\n    { label: '4k', value: -3 },\n    { label: '16k', value: 2 }\n  ];\n</script>\n\n<div class=\"flex h-48 justify-center gap-8\">\n  {#each bands as band (band.label)}\n    <Slider aria-label={band.label} value={band.value} max={5} min={-5} orientation=\"vertical\" />\n  {/each}\n</div>\n"
		}
	],
	"registryDependencies": [
		"slider"
	],
	"dependencies": []
}