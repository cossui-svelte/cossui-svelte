{
	"$schema": "https://ui.shadcn.com/schema/registry-item.json",
	"name": "otp-field",
	"title": "Otp Field",
	"description": "A segmented input for one-time passwords and verification codes.",
	"type": "registry:ui",
	"files": [
		{
			"type": "registry:ui",
			"path": "otp-field/index.ts",
			"target": "$lib/components/ui/otp-field/index.ts",
			"content": "export { default as OTPField } from './otp-field.svelte';\nexport { default as OTPFieldInput } from './otp-field-input.svelte';\nexport { default as OTPFieldSeparator } from './otp-field-separator.svelte';\n"
		},
		{
			"type": "registry:ui",
			"path": "otp-field/otp-field-input.svelte",
			"target": "$lib/components/ui/otp-field/otp-field-input.svelte",
			"content": "<script lang=\"ts\">\n  import { PinInput as OTPFieldPrimitive } from 'bits-ui';\n  import { cn } from '$lib/utils';\n\n  let {\n    ref = $bindable(null),\n    cell,\n    class: className,\n    placeholder,\n    mask = false,\n    ...restProps\n  }: OTPFieldPrimitive.CellProps & {\n    placeholder?: string;\n    mask?: boolean;\n  } = $props();\n</script>\n\n<OTPFieldPrimitive.Cell\n  {cell}\n  bind:ref\n  data-slot=\"otp-field-input\"\n  class={cn(\n    'relative inline-flex size-9 items-center justify-center rounded-lg border border-input bg-background not-dark:bg-clip-padding text-base text-foreground shadow-xs/5 outline-none ring-ring/24 transition-shadow before:pointer-events-none before:absolute before:inset-0 before:rounded-[calc(var(--radius-lg)-1px)] not-data-active:not-aria-invalid:before:shadow-[0_1px_--theme(--color-black/4%)] aria-invalid:border-destructive/36 data-active:z-10 data-active:border-ring data-active:ring-[3px] data-active:ring-ring/24 data-active:aria-invalid:border-destructive/64 data-active:aria-invalid:ring-destructive/16 in-[[data-slot=otp-field][data-size=lg]]:size-10 in-[[data-slot=otp-field][data-size=lg]]:text-lg sm:size-8 sm:text-sm sm:in-[[data-slot=otp-field][data-size=lg]]:size-9 sm:in-[[data-slot=otp-field][data-size=lg]]:text-base dark:bg-input/32 dark:not-data-active:not-aria-invalid:before:shadow-[0_-1px_--theme(--color-white/6%)] dark:data-active:aria-invalid:ring-destructive/24 [[data-active],[aria-invalid]]:shadow-none',\n    className\n  )}\n  {...restProps}\n>\n  {#if cell.char}\n    {mask ? '•' : cell.char}\n  {:else if placeholder && !cell.isActive}\n    <span class=\"text-muted-foreground\">{placeholder}</span>\n  {/if}\n  {#if cell.hasFakeCaret}\n    <div class=\"pointer-events-none absolute inset-0 flex items-center justify-center\">\n      <div class=\"h-4 w-px animate-caret-blink bg-foreground\"></div>\n    </div>\n  {/if}\n</OTPFieldPrimitive.Cell>\n"
		},
		{
			"type": "registry:ui",
			"path": "otp-field/otp-field-separator.svelte",
			"target": "$lib/components/ui/otp-field/otp-field-separator.svelte",
			"content": "<script lang=\"ts\">\n  import { Separator } from 'bits-ui';\n  import { cn } from '$lib/utils';\n\n  let { ref = $bindable(null), class: className, ...restProps }: Separator.RootProps = $props();\n</script>\n\n<Separator.Root\n  bind:ref\n  orientation=\"horizontal\"\n  data-slot=\"otp-field-separator\"\n  class={cn(\n    'rounded-full bg-input data-[orientation=horizontal]:h-0.5 data-[orientation=horizontal]:w-3',\n    className\n  )}\n  {...restProps}\n/>\n"
		},
		{
			"type": "registry:ui",
			"path": "otp-field/otp-field.svelte",
			"target": "$lib/components/ui/otp-field/otp-field.svelte",
			"content": "<script lang=\"ts\">\n  import { PinInput as OTPFieldPrimitive } from 'bits-ui';\n  import { cn } from '$lib/utils';\n\n  let {\n    ref = $bindable(null),\n    class: className,\n    value = $bindable(''),\n    size = 'default',\n    ...restProps\n  }: Omit<OTPFieldPrimitive.RootProps, 'size'> & {\n    size?: 'default' | 'lg';\n  } = $props();\n</script>\n\n<div data-slot=\"otp-field\" data-size={size}>\n  <OTPFieldPrimitive.Root\n    bind:ref\n    bind:value\n    spellcheck={false}\n    class={cn(\n      'flex items-center gap-2 has-disabled:opacity-64 has-disabled:**:data-[slot=otp-field-input]:shadow-none has-disabled:**:data-[slot=otp-field-input]:before:shadow-none!',\n      className\n    )}\n    {...restProps}\n  />\n</div>\n"
		}
	],
	"registryDependencies": [
		"utils"
	],
	"dependencies": [
		"bits-ui@^2.18.2"
	]
}