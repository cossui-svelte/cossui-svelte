{
	"$schema": "https://ui.shadcn.com/schema/registry-item.json",
	"name": "pagination",
	"title": "Pagination",
	"description": "A pagination with page navigation, next and previous links.",
	"type": "registry:ui",
	"files": [
		{
			"type": "registry:ui",
			"path": "pagination/index.ts",
			"target": "$lib/components/ui/pagination/index.ts",
			"content": "/* eslint-disable perfectionist/sort-named-exports */\n\nexport { default as Pagination } from './pagination.svelte';\nexport { default as PaginationContent } from './pagination-content.svelte';\nexport { default as PaginationEllipsis } from './pagination-ellipsis.svelte';\nexport { default as PaginationItem } from './pagination-item.svelte';\nexport { default as PaginationLink } from './pagination-link.svelte';\nexport { default as PaginationNext } from './pagination-next-button.svelte';\nexport { default as PaginationPrevious } from './pagination-prev-button.svelte';\n"
		},
		{
			"type": "registry:ui",
			"path": "pagination/pagination-content.svelte",
			"target": "$lib/components/ui/pagination/pagination-content.svelte",
			"content": "<script lang=\"ts\">\n  import type { HTMLAttributes } from 'svelte/elements';\n  import { cn, type WithElementRef } from '$lib/utils';\n\n  let {\n    children,\n    class: className,\n    ref = $bindable(null),\n    ...restProps\n  }: WithElementRef<HTMLAttributes<HTMLUListElement>> = $props();\n</script>\n\n<ul\n  bind:this={ref}\n  class={cn('flex flex-row items-center gap-1', className)}\n  data-slot=\"pagination-content\"\n  {...restProps}\n>\n  {@render children?.()}\n</ul>\n"
		},
		{
			"type": "registry:ui",
			"path": "pagination/pagination-ellipsis.svelte",
			"target": "$lib/components/ui/pagination/pagination-ellipsis.svelte",
			"content": "<script lang=\"ts\">\n  import Ellipsis from '@lucide/svelte/icons/ellipsis';\n  import type { HTMLAttributes } from 'svelte/elements';\n  import { cn, type WithElementRef, type WithoutChildren } from '$lib/utils';\n\n  let {\n    class: className,\n    ref = $bindable(null),\n    ...restProps\n  }: WithoutChildren<WithElementRef<HTMLAttributes<HTMLSpanElement>>> = $props();\n</script>\n\n<span\n  bind:this={ref}\n  aria-hidden=\"true\"\n  class={cn('flex min-w-7 justify-center', className)}\n  data-slot=\"pagination-ellipsis\"\n  {...restProps}\n>\n  <Ellipsis class=\"size-5 sm:size-4\" />\n  <span class=\"sr-only\">More pages</span>\n</span>\n"
		},
		{
			"type": "registry:ui",
			"path": "pagination/pagination-item.svelte",
			"target": "$lib/components/ui/pagination/pagination-item.svelte",
			"content": "<script lang=\"ts\">\n  import type { HTMLLiAttributes } from 'svelte/elements';\n  import type { WithElementRef } from '$lib/utils';\n\n  let {\n    children,\n    ref = $bindable(null),\n    ...restProps\n  }: WithElementRef<HTMLLiAttributes> = $props();\n</script>\n\n<li bind:this={ref} data-slot=\"pagination-item\" {...restProps}>\n  {@render children?.()}\n</li>\n"
		},
		{
			"type": "registry:ui",
			"path": "pagination/pagination-link.svelte",
			"target": "$lib/components/ui/pagination/pagination-link.svelte",
			"content": "<script module lang=\"ts\">\n  import type { Snippet } from 'svelte';\n  import type { HTMLAnchorAttributes } from 'svelte/elements';\n  import { type ButtonSize, buttonVariants } from '$lib/components/ui/button';\n  import type { WithElementRef } from '$lib/utils';\n\n  export type Props = WithElementRef<HTMLAnchorAttributes> & {\n    children: Snippet;\n    isActive?: boolean;\n    isDisabled?: boolean;\n    size?: ButtonSize;\n  };\n</script>\n\n<script lang=\"ts\">\n  import { cn } from '$lib/utils';\n\n  let {\n    children,\n    class: className,\n    isActive = false,\n    ref = $bindable(null),\n    size = 'icon',\n    ...restProps\n  }: Props = $props();\n</script>\n\n<a\n  aria-current={isActive ? 'page' : undefined}\n  class={cn(\n    buttonVariants({\n      size,\n      variant: isActive ? 'outline' : 'ghost'\n    }),\n    className\n  )}\n  data-active={isActive}\n  data-slot=\"pagination-link\"\n  {...restProps}\n>\n  {@render children()}\n</a>\n"
		},
		{
			"type": "registry:ui",
			"path": "pagination/pagination-next-button.svelte",
			"target": "$lib/components/ui/pagination/pagination-next-button.svelte",
			"content": "<script lang=\"ts\">\n  import ChevronRight from '@lucide/svelte/icons/chevron-right';\n  import { cn } from '$lib/utils';\n  import PaginationLink, { type Props as PaginationLinkProps } from './pagination-link.svelte';\n\n  let {\n    class: className,\n    ref = $bindable(null),\n    ...restProps\n  }: Omit<PaginationLinkProps, 'children'> = $props();\n</script>\n\n<PaginationLink\n  bind:ref\n  aria-label=\"Go to next page\"\n  size=\"default\"\n  class={cn('max-sm:aspect-square max-sm:p-0', className)}\n  {...restProps}\n>\n  <span class=\"max-sm:hidden\">Next</span>\n  <ChevronRight className=\"sm:-me-1\" />\n</PaginationLink>\n"
		},
		{
			"type": "registry:ui",
			"path": "pagination/pagination-prev-button.svelte",
			"target": "$lib/components/ui/pagination/pagination-prev-button.svelte",
			"content": "<script lang=\"ts\">\n  import ChevronLeft from '@lucide/svelte/icons/chevron-left';\n  import { cn } from '$lib/utils';\n  import PaginationLink, { type Props as PaginationLinkProps } from './pagination-link.svelte';\n\n  let {\n    class: className,\n    ref = $bindable(null),\n    ...restProps\n  }: Omit<PaginationLinkProps, 'children'> = $props();\n</script>\n\n<PaginationLink\n  bind:ref\n  aria-label=\"Go to previous page\"\n  size=\"default\"\n  class={cn('max-sm:aspect-square max-sm:p-0', className)}\n  {...restProps}\n>\n  <ChevronLeft class=\"sm:-ms-1\" />\n  <span class=\"max-sm:hidden\">Previous</span>\n</PaginationLink>\n"
		},
		{
			"type": "registry:ui",
			"path": "pagination/pagination.svelte",
			"target": "$lib/components/ui/pagination/pagination.svelte",
			"content": "<script lang=\"ts\">\n  import type { Snippet } from 'svelte';\n  import type { SvelteHTMLElements } from 'svelte/elements';\n  import { cn, type WithElementRef } from '$lib/utils';\n\n  type Props = WithElementRef<SvelteHTMLElements['nav']> & {\n    children: Snippet;\n  };\n\n  let { children, class: className, ref = $bindable(null), ...restProps }: Props = $props();\n</script>\n\n<nav\n  aria-label=\"pagination\"\n  class={cn('mx-auto flex w-full justify-center', className)}\n  data-slot=\"pagination\"\n  {...restProps}\n>\n  {@render children()}\n</nav>\n"
		}
	],
	"registryDependencies": [
		"button",
		"utils"
	],
	"dependencies": []
}