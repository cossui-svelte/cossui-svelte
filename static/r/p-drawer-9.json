{
	"$schema": "https://ui.shadcn.com/schema/registry-item.json",
	"name": "p-drawer-9",
	"title": "Drawer 9",
	"description": "Bottom drawer with snap points",
	"type": "registry:block",
	"files": [
		{
			"type": "registry:block",
			"path": "p-drawer-9.svelte",
			"target": "$lib/components/particles/drawer/p-drawer-9.svelte",
			"content": "<script lang=\"ts\">\n  import { buttonVariants } from '$lib/components/ui/button';\n  import {\n    Drawer,\n    DrawerDescription,\n    DrawerHeader,\n    DrawerPanel,\n    DrawerPopup,\n    DrawerTitle,\n    DrawerTrigger\n  } from '$lib/components/ui/drawer';\n\n  const snapPoints = ['300px', 1] as const;\n  let snapPoint = $state<(typeof snapPoints)[number] | null>(snapPoints[0]);\n\n  const boxes = Array.from({ length: 48 }, (_, i) => i);\n</script>\n\n<Drawer position=\"bottom\" bind:snapPoint snapPoints={[...snapPoints]}>\n  <DrawerTrigger class={buttonVariants({ variant: 'outline' })}>With snap points</DrawerTrigger>\n  <DrawerPopup showBar>\n    <DrawerHeader>\n      <DrawerTitle>Snap Points</DrawerTitle>\n      <DrawerDescription>\n        Drag the drawer to snap between a compact peek and full-height view.\n      </DrawerDescription>\n    </DrawerHeader>\n    <DrawerPanel>\n      <div class=\"flex flex-col gap-2\">\n        {#each boxes as i (i)}\n          <div class=\"h-12 shrink-0 rounded-xl border bg-muted\"></div>\n        {/each}\n      </div>\n    </DrawerPanel>\n  </DrawerPopup>\n</Drawer>\n"
		}
	],
	"registryDependencies": [
		"button",
		"drawer"
	],
	"dependencies": []
}