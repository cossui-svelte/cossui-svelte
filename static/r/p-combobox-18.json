{
	"$schema": "https://ui.shadcn.com/schema/registry-item.json",
	"name": "p-combobox-18",
	"title": "Combobox 18",
	"description": "Combobox with select trigger",
	"type": "registry:block",
	"files": [
		{
			"type": "registry:block",
			"path": "p-combobox-18.svelte",
			"target": "$lib/components/particles/combobox/p-combobox-18.svelte",
			"content": "<script lang=\"ts\">\n  import Search from '@lucide/svelte/icons/search';\n  import {\n    Combobox,\n    ComboboxCollection,\n    ComboboxEmpty,\n    ComboboxInput,\n    ComboboxItem,\n    ComboboxList,\n    ComboboxPopup,\n    ComboboxTrigger,\n    ComboboxValue\n  } from '$lib/components/ui/combobox';\n  import { selectTriggerVariants } from '$lib/components/ui/select';\n\n  const items = [\n    { label: 'Apple', value: 'apple' },\n    { label: 'Banana', value: 'banana' },\n    { label: 'Orange', value: 'orange' },\n    { label: 'Grape', value: 'grape' },\n    { label: 'Strawberry', value: 'strawberry' },\n    { label: 'Mango', value: 'mango' },\n    { label: 'Pineapple', value: 'pineapple' },\n    { label: 'Kiwi', value: 'kiwi' },\n    { label: 'Peach', value: 'peach' },\n    { label: 'Pear', value: 'pear' }\n  ];\n\n  let value = $state<string | undefined>(undefined);\n</script>\n\n<Combobox bind:value {items}>\n  <ComboboxTrigger class={selectTriggerVariants()}>\n    <ComboboxValue placeholder=\"Select a fruit\" />\n  </ComboboxTrigger>\n  <ComboboxPopup aria-label=\"Select a fruit\">\n    <div class=\"border-b p-2\">\n      <ComboboxInput\n        class=\"rounded-md before:rounded-[calc(var(--radius-md)-1px)]\"\n        placeholder=\"Search fruits...\"\n        showTrigger={false}\n      >\n        {#snippet startAddon()}\n          <Search />\n        {/snippet}\n      </ComboboxInput>\n    </div>\n    <ComboboxEmpty>No items found.</ComboboxEmpty>\n    <ComboboxList>\n      <ComboboxCollection>\n        {#snippet children(item: { label: string; value: string })}\n          <ComboboxItem value={item.value} label={item.label}>{item.label}</ComboboxItem>\n        {/snippet}\n      </ComboboxCollection>\n    </ComboboxList>\n  </ComboboxPopup>\n</Combobox>\n"
		}
	],
	"registryDependencies": [
		"combobox",
		"select"
	],
	"dependencies": [
		"@lucide/svelte"
	]
}