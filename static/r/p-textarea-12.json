{
	"$schema": "https://ui.shadcn.com/schema/registry-item.json",
	"name": "p-textarea-12",
	"title": "Textarea 12",
	"description": "Textarea field with required indicator",
	"type": "registry:block",
	"files": [
		{
			"type": "registry:block",
			"path": "p-textarea-12.svelte",
			"target": "$lib/components/particles/textarea/p-textarea-12.svelte",
			"content": "<script lang=\"ts\">\n  import { Button } from '$lib/components/ui/button';\n  import { Field, FieldError, FieldLabel } from '$lib/components/ui/field';\n  import { Form } from '$lib/components/ui/form';\n  import { Textarea } from '$lib/components/ui/textarea';\n\n  let loading = $state(false);\n\n  async function handleSubmit(event: SubmitEvent) {\n    event.preventDefault();\n    const formData = new FormData(event.currentTarget as HTMLFormElement);\n    loading = true;\n    await new Promise((r) => setTimeout(r, 800));\n    loading = false;\n    alert(`Message: ${formData.get('message') ?? ''}`);\n  }\n</script>\n\n<Form class=\"flex w-full flex-col gap-4\" onsubmit={handleSubmit}>\n  <Field name=\"message\">\n    <FieldLabel class=\"text-sm font-medium\">\n      Message <span class=\"text-destructive-foreground\">*</span>\n    </FieldLabel>\n    <Textarea placeholder=\"Type your message here\" required />\n    <FieldError>Please fill out this field.</FieldError>\n  </Field>\n  <Button {loading} type=\"submit\">Submit</Button>\n</Form>\n"
		}
	],
	"registryDependencies": [
		"button",
		"field",
		"form",
		"textarea"
	],
	"dependencies": []
}