{
	"$schema": "https://ui.shadcn.com/schema/registry-item.json",
	"name": "p-sidebar-3",
	"title": "Sidebar 3",
	"description": "Sidebar header holding a workspace switcher menu",
	"type": "registry:block",
	"files": [
		{
			"type": "registry:block",
			"path": "p-sidebar-3.svelte",
			"target": "$lib/components/particles/sidebar/p-sidebar-3.svelte",
			"content": "<script lang=\"ts\">\n  import ChevronDownIcon from '@lucide/svelte/icons/chevron-down';\n  import { Menu, MenuItem, MenuPopup, MenuTrigger } from '$lib/components/ui/menu';\n  import {\n    Sidebar,\n    SidebarContent,\n    SidebarHeader,\n    SidebarInset,\n    SidebarMenu,\n    SidebarMenuButton,\n    SidebarMenuItem,\n    SidebarProvider,\n    SidebarTrigger\n  } from '$lib/components/ui/sidebar';\n</script>\n\n<!-- transform-gpu makes this box the containing block for the sidebar's `fixed`\n     panel, so the demo stays inside the preview card instead of the viewport. -->\n<div class=\"relative h-100 w-full transform-gpu overflow-hidden rounded-xl border\">\n  <SidebarProvider class=\"h-full min-h-full\">\n    <Sidebar class=\"h-full\">\n      <SidebarHeader>\n        <SidebarMenu>\n          <SidebarMenuItem>\n            <Menu>\n              <SidebarMenuButton>\n                {#snippet child({ props })}\n                  <MenuTrigger\n                    {...props}\n                    class=\"data-popup-open:bg-sidebar-accent data-popup-open:text-sidebar-accent-foreground\"\n                  >\n                    Select Workspace\n                    <ChevronDownIcon class=\"ms-auto\" />\n                  </MenuTrigger>\n                {/snippet}\n              </SidebarMenuButton>\n              <MenuPopup align=\"start\" class=\"w-(--anchor-width)\">\n                <MenuItem>\n                  <span>Acme Inc</span>\n                </MenuItem>\n                <MenuItem>\n                  <span>Acme Corp.</span>\n                </MenuItem>\n              </MenuPopup>\n            </Menu>\n          </SidebarMenuItem>\n        </SidebarMenu>\n      </SidebarHeader>\n      <SidebarContent />\n    </Sidebar>\n    <SidebarInset class=\"h-full\">\n      <header class=\"flex h-12 shrink-0 items-center gap-2 border-b px-3\">\n        <SidebarTrigger />\n        <span class=\"font-medium text-sm\">Workspace</span>\n      </header>\n      <div class=\"p-4 text-muted-foreground text-sm\">Content area</div>\n    </SidebarInset>\n  </SidebarProvider>\n</div>\n"
		}
	],
	"registryDependencies": [
		"menu",
		"sidebar"
	],
	"dependencies": [
		"@lucide/svelte"
	]
}