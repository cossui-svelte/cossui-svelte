{
	"$schema": "https://ui.shadcn.com/schema/registry-item.json",
	"name": "p-field-2",
	"title": "Field 2",
	"description": "Field with required indicator",
	"type": "registry:block",
	"files": [
		{
			"type": "registry:block",
			"path": "p-field-2.svelte",
			"target": "$lib/components/particles/field/p-field-2.svelte",
			"content": "<script lang=\"ts\">\n  import { z } from 'zod';\n  import { Button } from '$lib/components/ui/button';\n  import { Field, FieldError, FieldLabel } from '$lib/components/ui/field';\n  import { Form } from '$lib/components/ui/form';\n  import { Input } from '$lib/components/ui/input';\n  import { createForm } from '$lib/hooks/use-superform';\n\n  const schema = z.object({\n    password: z.string().min(1, { message: 'Please fill out this field.' })\n  });\n\n  const superform = createForm({\n    onUpdated: (_data) => {\n      alert(`Password submitted`);\n    },\n    schema\n  });\n\n  const { form, submitting } = superform;\n</script>\n\n<Form class=\"flex w-full flex-col gap-4\" {superform}>\n  <Field name=\"password\">\n    <FieldLabel>Password <span class=\"text-destructive-foreground\">*</span></FieldLabel>\n    <Input bind:value={$form.password} placeholder=\"Enter password\" type=\"password\" />\n    <FieldError />\n  </Field>\n  <Button loading={$submitting} type=\"submit\">Submit</Button>\n</Form>\n"
		}
	],
	"registryDependencies": [
		"button",
		"field",
		"form",
		"input",
		"use-superform"
	],
	"dependencies": [
		"zod",
		"zod@^4.4.3"
	]
}