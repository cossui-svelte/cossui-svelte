{
	"$schema": "https://ui.shadcn.com/schema/registry-item.json",
	"name": "p-field-2",
	"title": "Field 2",
	"description": "Field with required indicator",
	"type": "registry:block",
	"files": [
		{
			"type": "registry:block",
			"path": "p-field-2.svelte",
			"target": "$lib/components/particles/field/p-field-2.svelte",
			"content": "<script lang=\"ts\">\n  import { Button } from '$lib/components/ui/button';\n  import { Field, FieldError, FieldLabel } from '$lib/components/ui/field';\n  import { Form } from '$lib/components/ui/form';\n  import { Input } from '$lib/components/ui/input';\n\n  let loading = $state(false);\n\n  async function handleSubmit(event: SubmitEvent) {\n    event.preventDefault();\n    loading = true;\n    await new Promise((r) => setTimeout(r, 800));\n    loading = false;\n    alert('Password submitted');\n  }\n</script>\n\n<Form class=\"flex w-full flex-col gap-4\" onsubmit={handleSubmit}>\n  <Field name=\"password\">\n    <FieldLabel>Password <span class=\"text-destructive-foreground\">*</span></FieldLabel>\n    <Input placeholder=\"Enter password\" required type=\"password\" />\n    <FieldError>Please fill out this field.</FieldError>\n  </Field>\n  <Button loading={loading} type=\"submit\">Submit</Button>\n</Form>\n"
		}
	],
	"registryDependencies": [
		"button",
		"field",
		"form",
		"input"
	],
	"dependencies": []
}