{
	"$schema": "https://ui.shadcn.com/schema/registry-item.json",
	"name": "p-cropper-8",
	"title": "Cropper 8",
	"description": "Cropper with zoom slider",
	"type": "registry:block",
	"files": [
		{
			"type": "registry:block",
			"path": "p-cropper-8.svelte",
			"target": "$lib/components/particles/cropper/p-cropper-8.svelte",
			"content": "<script lang=\"ts\">\n  import {\n    Cropper,\n    CropperCropArea,\n    CropperDescription,\n    CropperImage\n  } from '$lib/components/ui/cropper';\n  import { Slider } from '$lib/components/ui/slider';\n\n  let zoom = $state(1);\n</script>\n\n<div class=\"flex w-full flex-col items-center gap-2\">\n  <div class=\"flex w-full flex-col gap-4\">\n    <Cropper class=\"h-80\" image=\"/img/cropper/cropper-07_scsejv.jpg\" bind:zoom>\n      <CropperDescription />\n      <CropperImage />\n      <CropperCropArea />\n    </Cropper>\n    <div class=\"mx-auto flex w-full max-w-80 items-center gap-1\">\n      <Slider aria-label=\"Zoom slider\" bind:value={zoom} max={3} min={1} step={0.1} />\n      <output class=\"block w-10 shrink-0 text-right font-medium text-sm tabular-nums\">\n        {Number.parseFloat(zoom.toFixed(1))}x\n      </output>\n    </div>\n  </div>\n</div>\n"
		}
	],
	"registryDependencies": [
		"cropper",
		"slider"
	],
	"dependencies": []
}